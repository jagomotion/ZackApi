<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ZackApi</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23202124'/><text x='50' y='70' font-size='60' font-family='sans-serif' font-weight='700' fill='white' text-anchor='middle'>Z</text></svg>" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,500,0,0" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- ============================================================
       LOADING SCREEN (Aurora Blur)
       ============================================================ -->
  <div class="loader" id="loader">
    <div class="aurora">
      <div class="aurora-blob a1"></div>
      <div class="aurora-blob a2"></div>
      <div class="aurora-blob a3"></div>
      <div class="aurora-blob a4"></div>
    </div>
    <div class="loader-content">
      <div class="loader-logo">
        <span>Z</span>
      </div>
      <div class="loader-bar">
        <div class="loader-bar-fill"></div>
      </div>
      <div class="loader-text">Memuat</div>
    </div>
  </div>

  <!-- ============================================================
       APP
       ============================================================ -->
  <header>
    <a href="/" class="brand">
      <div class="brand-logo">Z</div>
      <span class="brand-name">ZackApi</span>
    </a>
    <nav>
      <a href="/player" class="nav-link">
        <span class="material-symbols-rounded">play_circle</span>
        <span>Player</span>
      </a>
      <a href="/api/health" target="_blank" class="nav-link">
        <span class="material-symbols-rounded">favorite</span>
        <span>Health</span>
      </a>
      <a href="/api/stats" target="_blank" class="nav-link">
        <span class="material-symbols-rounded">bar_chart</span>
        <span>Stats</span>
      </a>
    </nav>
  </header>

  <main>
    <div class="top">
      <div class="base-url">
        <span class="material-symbols-rounded">link</span>
        <code id="baseUrl"><%= baseUrl %></code>
        <button type="button" data-copy="<%= baseUrl %>">
          <span class="material-symbols-rounded">content_copy</span>
        </button>
      </div>

      <div class="search-box">
        <span class="material-symbols-rounded">search</span>
        <input id="filter" type="text" placeholder="Cari endpoint" autocomplete="off" />
      </div>
    </div>

    <div class="tabs" id="tabs">
      <button class="tab active" data-cat="all">Semua</button>
      <button class="tab" data-cat="system">System</button>
      <button class="tab" data-cat="email">Email</button>
      <button class="tab" data-cat="music">Music</button>
      <button class="tab" data-cat="spotify">Spotify</button>
    </div>

    <section class="endpoints">
      <div class="skeleton-wrap" id="skeleton">
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
        <div class="skeleton"></div>
      </div>

      <div class="grid" id="grid" style="display:none;">
        <% endpoints.forEach(function (ep) {
          var cat = 'system';
          if (ep.path.indexOf('/api/spotify') === 0) cat = 'spotify';
          else if (ep.path.indexOf('/api/music') === 0) cat = 'music';
          else if (ep.path.indexOf('/api/health') === 0 || ep.path.indexOf('/api/stats') === 0) cat = 'system';
          else if (ep.path.indexOf('/api/') === 0) cat = 'email';
        %>
          <article class="card cat-<%= cat %>" data-cat="<%= cat %>" data-path="<%= ep.path %>" data-desc="<%= ep.desc %>">
            <div class="card-head">
              <span class="method">GET</span>
              <code class="path"><%= ep.path %></code>
            </div>
            <p class="desc"><%= ep.desc %></p>
            <div class="params">
              <span class="params-label">Params</span>
              <code><%= ep.params %></code>
            </div>
            <div class="actions">
              <button type="button" class="btn-copy" data-copy="<%= baseUrl %><%= ep.path %><%= ep.example %>">
                <span class="material-symbols-rounded">content_copy</span>
                <span>Copy</span>
              </button>
              <a class="btn-try" href="<%= ep.path %><%= ep.example %>" target="_blank" rel="noopener">
                <span class="material-symbols-rounded">arrow_outward</span>
                <span>Try</span>
              </a>
            </div>
          </article>
        <% }) %>
      </div>

      <div class="empty-state" id="empty" style="display:none;">
        <span class="material-symbols-rounded">search_off</span>
        <p>Tidak ditemukan</p>
      </div>
    </section>
  </main>

  <footer>
    <span>ZackApi &copy; <%= year %></span>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>